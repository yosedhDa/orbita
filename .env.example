# Cadena de conexión PostgreSQL (Supabase, Neon, Railway, RDS, local...)
DATABASE_URL=postgres://app:app@localhost:5432/orbita
# URL pública de la aplicación (se usa en enlaces de invitación y recuperación)
APP_URL=http://localhost:3000
# Opcional: SMTP para enviar invitaciones, recuperación de contraseña y avisos por correo.
# Si no se configura, la app muestra el enlace de invitación para copiarlo manualmente
# y la recuperación de contraseña sólo funciona en desarrollo (enlace en la consola del servidor).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Orbita <no-reply@tu-dominio.com>"
# Usar SSL en conexión a la BD (true en proveedores gestionados)
DATABASE_SSL=false

# Zona horaria para fechas "hoy", vencimientos y horas de reuniones (IANA)
APP_TIMEZONE=America/Mexico_City
